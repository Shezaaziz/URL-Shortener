    <title>SignUp</title>
    <style>
        div{
     display: flex;
            align-items: center;
            

        }
        h1{
         text-align: center;
        }
    </style>
</head>
<body>
    <h1>SignUp</h1>
    <div>
    <form action="/user" method="post">
        <label>Full Name</label>
        <input type="name" name="name" placeholder="Enter Full Name">
              <label>Email</label>
        <input type="email" name="email" placeholder="example@gmail.com">
          <label>password</label>
